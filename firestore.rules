rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin allow-list. This must stay in sync with VITE_ADMIN_EMAILS.
    // A custom claim (`request.auth.token.admin`) would be stronger, because
    // an email can be changed in the Google account; see the README.
    function isAdmin() {
      return isSignedIn()
             && request.auth.token.email in [
                  'gopalkumarpandit8298@gmail.com'
                ];
    }

    // ---- Catalogue: public read, admin-only writes ------------------------
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // Menus are a subcollection so a restaurant page needs exactly one read.
      match /menu/{itemId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- Orders ------------------------------------------------------------
    // Customers: create their own, read their own. Admins: read and update all.
    match /orders/{orderId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.totals.total is number;
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Sequential order numbers. Checkout needs to write this; only admins read.
    match /orderCounters/{counterId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
