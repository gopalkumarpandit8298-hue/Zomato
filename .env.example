# ---------------------------------------------------------------------------
# Firebase Web App config  (Firebase Console > Project Settings > General > SDK setup)
# Copy this file to `.env` and paste your own values.
# `.env` is git-ignored, so your keys never get committed.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Storage needs a provisioned bucket, which requires a billing account on
# the project. Leave this `false` until the bucket exists and `npm run seed` has
# uploaded the images — otherwise every image lookup fails and the app falls
# back to the local `/img/` copies (which is fine, just noisier in the console).
VITE_FIREBASE_STORAGE_ENABLED=false

# Comma-separated emails allowed into /admin. Firebase Auth verifies the
# password; this list only decides who gets the admin UI. Keep the same list in
# firestore.rules — the client-side check is UX, the rules are the real gate.
VITE_ADMIN_EMAILS=
